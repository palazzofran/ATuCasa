# Copiá este archivo como .env y completá los valores.
DATABASE_URL=sqlite:///./atucasa.db
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# URL del backend que se usa en los links de los mails
APP_URL=http://localhost:8000

# Envío de mails. Si SMTP_HOST queda vacío, los mails se guardan como .html
# en backend/correos_salientes/ en lugar de enviarse.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu cuenta y
# SMTP_PASSWORD=una "contraseña de aplicación" (no tu contraseña normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
